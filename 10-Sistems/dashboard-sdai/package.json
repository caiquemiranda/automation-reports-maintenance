{
  "name": "dashboard-sdai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "app": "node scripts/start.mjs",
    "app:prod": "node scripts/start.mjs --prod",
    "dev": "vite",
    "server": "node --disable-warning=ExperimentalWarning --watch-path=server --watch-path=src/lib server/index.js",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:incremental": "node --disable-warning=ExperimentalWarning scripts/test-incremental.mjs",
    "validate": "node scripts/validate-log.mjs",
    "db:import": "node --disable-warning=ExperimentalWarning server/cli.js import",
    "db:check": "node --disable-warning=ExperimentalWarning server/cli.js check",
    "db:stats": "node --disable-warning=ExperimentalWarning server/cli.js stats"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
